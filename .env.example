# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Semua variabel di sini HANYA untuk server (jangan pakai awalan NEXT_PUBLIC_).

# Database MySQL 8 (utf8mb4)
# Lokal (Docker):  mysql://root:PASSWORD@localhost:3307/pelita
# Deploy:          MySQL terkelola di Singapura (Aiven, Railway, TiDB Cloud, dll.). Biasanya wajib SSL,
#                  misalnya tambahkan ?ssl={"rejectUnauthorized":true} di akhir URL.
DATABASE_URL="mysql://root:password@localhost:3307/pelita"

# Kunci enkripsi cookie sesi (iron-session), minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Password dan PIN akun demo (Admin, Ibu Sari, Kak Dina). Dipakai scripts/seed.ts, disimpan sebagai hash bcrypt.
DEMO_PASSWORD=""
DEMO_PIN=""

# LLM (hanya dipanggil dari server). Isi nama model terbaru dari dokumentasi penyedia pada hari-H.
PRIMARY_LLM_API_KEY=""
LLM_MODEL=""
BACKUP_LLM_API_KEY=""
BACKUP_LLM_MODEL=""
