# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
# Semua variabel di sini HANYA untuk server (jangan pakai awalan NEXT_PUBLIC_).

# Database: XAMPP (MariaDB) saat coding, Cloud SQL MySQL 8 saat deploy. Wajib utf8mb4.
# Lokal (XAMPP):    mysql://root@localhost:3306/pelita  (root XAMPP bawaan tanpa password)
# Cloud Run:        mysql://pelita_app:PASSWORD@localhost/pelita  (host diabaikan karena DB_SOCKET_PATH diisi)
# Seed ke Cloud SQL dari laptop: jalankan Cloud SQL Auth Proxy, lalu pakai mysql://...@127.0.0.1:PORT_PROXY/pelita
DATABASE_URL="mysql://root@localhost:3306/pelita"

# Hanya di Cloud Run: unix socket Cloud SQL. Kosongkan untuk lokal (XAMPP).
# Contoh: /cloudsql/PROJECT_ID:asia-southeast2:pelita-mysql
DB_SOCKET_PATH=""

# Kunci enkripsi cookie sesi (iron-session), minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Password dan PIN akun demo (Admin, Ibu Sari, Kak Dina). Dipakai scripts/seed.mts, disimpan sebagai hash bcrypt.
DEMO_PASSWORD=""
DEMO_PIN=""

# LLM (hanya dipanggil dari server). Isi nama model terbaru dari dokumentasi penyedia pada hari-H.
PRIMARY_LLM_API_KEY=""
LLM_MODEL=""
BACKUP_LLM_API_KEY=""
BACKUP_LLM_MODEL=""
